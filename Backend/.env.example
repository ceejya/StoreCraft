# Copy to .env for local dev. On Render, add each of these under Environment.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/storecraft
JWT_SECERETKEY=replace-with-a-long-random-string
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-gmail-app-password
CLOUDINARY_CLOUDNAME=
CLOUDINARY_APIKEY=
CLOUDINARY_APISECRET=
# Payment secrets are backend-only; configure the same names in the backend host.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
# Public frontend origin used for provider return URLs.
STOREFRONT_URL=http://localhost:5173
# Comma-separated frontend origins allowed by CORS (no trailing slash)
CLIENT_URL=http://localhost:5173
NODE_ENV=development
